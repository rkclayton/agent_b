# and its operations carry RAW JSON. A CRLF checkout changes those bytes without
# changing their meaning, so the gate failed in CI and in any fresh clone while
# passing in the working tree the tapes were written in. Pinned, like the sources.
internal/projection/testdata/tapes/*.json text eol=lf
